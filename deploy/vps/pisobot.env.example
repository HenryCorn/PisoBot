# Install as /etc/pisobot/pisobot.env, root-owned mode 600. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional sharing: usernames allowed to /start their own search (owner included in MAX_USERS)
TELEGRAM_INVITE_USERNAMES=
MAX_USERS=2
TFL_APP_KEY=
STORAGE=local
PISOBOT_STATE_DIR=/var/lib/pisobot
FETCH_CHAIN=plain
FETCH_MIN_GAP_S=4
# rm Rightmove · otmr OnTheMarket · orent OpenRent · sr SpareRoom whole flats ·
# stbr/lqr London Living Rent & Rent to Buy (ShareToBuy, L&Q; refreshed every 3 h)
# ShareToBuy currently returns 403 from the VPS; add stbr only after an access check.
WATCH_SOURCES=rm,otmr,orent,sr,lqr
WATCH_INTERVAL_MIN=15
WATCH_FAILURE_LIMIT=3
RENT_REFRESH_MINUTES=15
RENT_MAX_PAGES=3
# Deep sweep (Rightmove + OnTheMarket): a full crawl of DEEP_SWEEP_MILES for rent up to 110% of the
# highest rent cap, in short resumable slices after each scan. DEEP_SWEEP_HOURS=0 turns it off.
DEEP_SWEEP_MILES=10
DEEP_SWEEP_HOURS=12
DEEP_SWEEP_MAX_REQUESTS=150
DEEP_SWEEP_STEP_SECONDS=120
DECODO_AUTH_TOKEN=
MAP_URL=
# Optional: a language model reads each advert (whole flat? room? short let? red flags, a one-line
# summary). OFF unless a key is set; on any error the keyword rules decide as before. Needs
# `pip install -r requirements-extract.txt`. Only the advert text and public listing fields are sent.
# ANTHROPIC_API_KEY=
# EXTRACT_MODEL=claude-haiku-5-5
# EXTRACT_DAILY_LIMIT=400
# EXTRACT_TIMEOUT_S=20
# EXTRACT_DISABLE=1
# Optional: HEALTHCHECK_URL=
