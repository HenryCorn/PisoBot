# Install as /etc/pisobot/pisobot.env, root-owned mode 600. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TFL_APP_KEY=
STORAGE=local
PISOBOT_STATE_DIR=/var/lib/pisobot
FETCH_CHAIN=plain
FETCH_MIN_GAP_S=4
WATCH_SOURCES=rm,otmr,orent
WATCH_INTERVAL_MIN=15
WATCH_FAILURE_LIMIT=3
RENT_REFRESH_MINUTES=15
RENT_MAX_PAGES=3
DECODO_AUTH_TOKEN=
MAP_URL=
# Optional: HEALTHCHECK_URL=
